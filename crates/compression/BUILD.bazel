load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "compression")

crate_tests(
    lib = "compression",
    # `differential` drives the JVM oracle under `tools/oracle`, which stayed in
    # the monorepo. It also holds `env!("CARGO_MANIFEST_DIR")` past compile time
    # to find that install, which rules_rust rejects as non-hermetic. Runs under
    # Cargo, not here.
    manual = ["differential"],
)
