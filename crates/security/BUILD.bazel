load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "security")

crate_tests(
    # The `#[cfg(test)]` TLS suites `include_str!` these at compile time; the
    # Kerberos suites read the keytabs at run time. Both lists are needed.
    compile_data = glob(["tests/fixtures/**"]),
    data = glob(["tests/fixtures/**"]),
    # The Kerberos suites open their keytabs by a crate-relative path. Bazel runs
    # a test from an execution root rather than the crate directory, so hand them
    # the package path inside the runfiles tree.
    env = {"FIXTURE_ROOT": "crates/security"},
    lib = "security",
)
