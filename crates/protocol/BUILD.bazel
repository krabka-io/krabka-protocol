load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# The generated wire codecs are pulled in with
# `include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/..."))`. That needs an
# *absolute* manifest dir, because a relative one resolves against the directory
# of each including file. rules_rust's process_wrapper substitutes `${pwd}` with
# the absolute exec root at action time; `$$` escapes Bazel's own Make-variable
# pass so the literal reaches it.
GENERATED_SOURCES = glob([
    "generated/**",
    "schemas/**",
])

MANIFEST_DIR = {"CARGO_MANIFEST_DIR": "$${pwd}/crates/protocol"}

# build.rs is deliberately not run here. It only checks that `generated/` matches
# the `schemas/` SHAs and emits no code, so under Bazel — which consumes the
# generated sources directly as compile_data — it is dead weight. The Cargo build
# and the codegen-check job still catch drift.
crate_library(
    name = "protocol",
    compile_data = GENERATED_SOURCES,
    rustc_env = MANIFEST_DIR,
)

crate_tests(
    lib = "protocol",
    data = glob([
        "tests/corpus/**",
        "tests/fixtures/**",
    ]),
    # The differential suites and `oracle_smoke` drive the JVM oracle under
    # `tools/oracle`, which stayed in the monorepo; `capture_corpus` records new
    # fixtures through it. `corpus_coverage` holds `CARGO_MANIFEST_DIR` past
    # compile time to walk `tests/corpus`, which rules_rust rejects as
    # non-hermetic. All of them still run under Cargo.
    manual = [
        "capture_corpus",
        "corpus_coverage",
        "corpus_replay",
        "differential_all",
        "differential_api_versions",
        "differential_describe_groups",
        "differential_metadata",
        "differential_offset_commit",
        "differential_produce",
        "differential_records",
        "kraft_metadata_roundtrip",
        "kraft_rpc_roundtrip",
        "oracle_smoke",
    ],
    no_harness = [
        "corpus_replay",
        "kraft_metadata_roundtrip",
        "kraft_rpc_roundtrip",
    ],
    compile_data = GENERATED_SOURCES,
    rustc_env = MANIFEST_DIR,
)
